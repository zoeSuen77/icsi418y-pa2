{
  "name": "icsi418y-pa2",
  "version": "1.0.0",
  "private": true,
  "description": "ICSI 418Y PA2 — React, Express, and MongoDB login and signup",
  "workspaces": ["client", "server"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "concurrently --kill-others -n server,client \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "demo": "node scripts/demo.cjs",
    "build": "npm run build --workspace client",
    "start": "npm start --workspace server",
    "test": "node --test tests/api.test.cjs",
    "test:ui": "playwright test",
    "db:users": "node scripts/show-users.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "concurrently": "^9.2.1",
    "mongodb-memory-server": "^11.3.0"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "7.0.14",
      "downloadDir": "./.cache/mongodb-binaries",
      "disablePostinstall": true
    }
  }
}
